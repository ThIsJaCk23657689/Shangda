{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr resources/js/ssr.ts",
        "legacy:install": "npm --prefix legacy ci",
        "legacy:build": "node legacy/node_modules/cross-env/src/bin/cross-env.js NODE_PATH=legacy/node_modules NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production node legacy/node_modules/webpack/bin/webpack.js --no-progress --config=legacy/node_modules/laravel-mix/setup/webpack.config.js",
        "types:check": "vue-tsc --noEmit",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "check": "npm run types:check && npm run test:unit && npm run build && npm run build:ssr"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@playwright/test": "^1.55.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.6",
        "jsdom": "^26.1.0",
        "laravel-vite-plugin": "^3.1.0",
        "tailwindcss": "^4.1.11",
        "typescript": "^5.8.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.5",
        "vue-tsc": "^2.2.4"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.9.5",
        "@rollup/rollup-win32-x64-msvc": "^4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
