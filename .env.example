APP_NAME="上大食品"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_TW

INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_TIMEOUT=3
RECAPTCHA_RETRIES=2

DASHBOARD_OVERDUE_DAYS=30

# 銷售分析 PDF 預設使用 resources/fonts 內的字型；僅在部署需覆寫時設定：
# SALES_ANALYSIS_PDF_FONT_REGULAR=/absolute/path/NotoSansTC-Regular.ttf
# SALES_ANALYSIS_PDF_FONT_BOLD=/absolute/path/NotoSansTC-Bold.ttf

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
